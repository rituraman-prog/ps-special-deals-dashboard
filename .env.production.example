# Salesforce API Credentials
# Get these from Salesforce Setup > App Manager > New Connected App

SALESFORCE_USERNAME=your-email@company.com
SALESFORCE_PASSWORD=your-salesforce-password
SALESFORCE_TOKEN=your-security-token
SALESFORCE_DOMAIN=login

# Note: SALESFORCE_DOMAIN should be 'login' for production or 'test' for sandbox

# Flask Configuration
FLASK_ENV=production
PORT=5001
